# Copy to .env (gitignored) and load it however you run manage.py, e.g.
# `set -a; source .env; set +a`. docker-compose.yml does not read this file --
# it passes its own development values directly as `environment:`.
#
# docker-compose.prod.yml DOES read it, but for a different and much shorter set
# of names -- see the PRODUCTION section at the bottom. Those are interpolated
# into the compose file rather than passed to Django directly, which is why they
# are not the same names as the ones above them.

# Postgres is the only backend; there is no sqlite fallback. These match the
# `db` service in docker-compose.yml.
POSTGRES_DB=zian_tsabit_be
POSTGRES_USER=zian_tsabit_be
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# TLS for the database connection. Unset means libpq's own default, 'prefer',
# which silently falls back to plaintext when the server has no TLS -- fine for
# the `db` service beside this one, where nothing is between the two containers,
# and not fine across a network. See docker-compose.external-db.yml.
#   require      encrypt, but do not check who answered
#   verify-full  encrypt and authenticate the server; needs the CA below
# POSTGRES_SSLMODE=
# Path *inside the container* to the CA that signed the server certificate, so
# the file has to be mounted in. Only read for verify-ca / verify-full.
# POSTGRES_SSLROOTCERT=

# Uploaded post images go to an S3-compatible bucket. These match the `rustfs`
# service in docker-compose.yml; `storage-init` beside it creates the bucket and
# makes it public-read. Running manage.py outside Docker needs
# `docker compose up rustfs storage-init` (or any S3) reachable at the endpoint
# below.
AWS_STORAGE_BUCKET_NAME=ziantsabit-media
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
# Django -> storage. Inside Docker this is http://rustfs:9000.
AWS_S3_ENDPOINT_URL=http://localhost:9000
# browser -> storage, i.e. what ends up in every image URL. Only differs from
# the line above when Django reaches the bucket by a name the browser cannot,
# which is exactly the case inside Docker.
# AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# MAX_UPLOAD_SIZE=10485760

# DJANGO_SECRET_KEY=
# DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Where collectstatic writes, and where WhiteNoise serves from. The image sets
# this to /srv/static, outside the bind-mounted source tree; outside Docker it
# defaults to ./staticfiles.
# DJANGO_STATIC_ROOT=
# Trust X-Forwarded-Proto from the proxy in front. Only safe when nothing can
# reach the process directly -- true behind cloudflared, false for runserver.
# USE_X_FORWARDED_PROTO=0

# What a *stranger* may write, per IP. These are the only two routes anyone can
# POST to without logging in: leaving a comment, and tapping a reaction. Django
# rate syntax, "<number>/<second|minute|hour|day>".
#
# The counters live in Django's cache, which defaults to a per-process
# LocMemCache -- so under gunicorn's several workers the real limit is roughly
# this times the worker count. Point CACHES at a shared backend if it has to be
# exact.
# COMMENT_RATE_LIMIT=20/hour
# REACTION_RATE_LIMIT=60/min


# PRODUCTION
# ----------
# These are read by docker-compose.prod.yml (Compose reads .env automatically)
# and interpolated into the service definitions. Compose refuses to start if any
# is missing, rather than quietly deploying a development default.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# See DEPLOY.md in the repository root.

# POSTGRES_PASSWORD=
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=
# DJANGO_SECRET_KEY=
# The API's own hostname, space-separated. Not the site's.
# DJANGO_ALLOWED_HOSTS=api.example.com
# The origin(s) serving the SPA. Fills both CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS -- the SPA allowed to read the API is the one that writes
# to it.
# SITE_ORIGINS=https://example.com https://www.example.com
# browser -> object storage. Written into the stored URL of every upload, so
# settle on it before the first one: changing it later 404s every image already
# published.
# MEDIA_ORIGIN=https://media.example.com

# Only with docker-compose.external-db.yml, i.e. a Postgres that is not the `db`
# service. POSTGRES_HOST is required by that file; the rest have defaults.
# POSTGRES_HOST=10.0.0.50
# POSTGRES_PORT=5432
# POSTGRES_DB=zian_tsabit_be
# POSTGRES_USER=zian_tsabit_be
# Defaults to `require` there, rather than to libpq's plaintext-tolerant
# `prefer`. Raise it to verify-full and mount the CA to authenticate the server
# as well as encrypt.
# POSTGRES_SSLMODE=require
# POSTGRES_SSLROOTCERT=/etc/ssl/postgres-ca.crt
